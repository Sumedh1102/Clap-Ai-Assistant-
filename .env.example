# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Claude model (default claude-opus-4-6)
# CLAP_MODEL=claude-opus-4-6

# ── CLAP voice (ElevenLabs) ───────────────────────────────────────────────────
# CLAP's voice is the ElevenLabs Voice Library voice "Serafina – Sensual Temptress"
# (the reference recording). Find and add it with:
#   python -m voice find serafina
#   python -m voice add <public_owner_id> <voice_id>
CLAP_TTS_API_KEY=
CLAP_TTS_VOICE_ID=
# Optional: eleven_multilingual_v2 (default, best fidelity) or eleven_flash_v2_5 (lower latency)
# CLAP_TTS_MODEL_ID=eleven_multilingual_v2
# Optional: elevenlabs (default when the two values above are set), macos, none
#   macos = explicit offline approximation with a built-in macOS voice — NOT the CLAP voice
# CLAP_TTS_PROVIDER=

# ── Web search (optional) ─────────────────────────────────────────────────────
# Free tier at https://api.search.brave.com
BRAVE_API_KEY=

# ── Gmail SMTP (optional) ─────────────────────────────────────────────────────
# Use an App Password — https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Default recipient for outbound emails
DEFAULT_EMAIL=

# ── Scheduler ─────────────────────────────────────────────────────────────────
MORNING_BRIEFING_TIME=08:00

# ── Personalisation ───────────────────────────────────────────────────────────
# Optional: your name; CLAP uses it sparingly
USER_NAME=

# ── Web interface ─────────────────────────────────────────────────────────────
WEB_PORT=7777
